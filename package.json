{
  "name": "openmedias-dashboard",
  "version": "1.0.0",
  "description": "Dashboard temps réel OpenMedias - Sales Performance",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=1024 server/index.js",
    "dev": "node --watch server/index.js",
    "build": "cd client && npm install && npm run build",
    "postinstall": "cd client && npm install && npm run build",
    "check": "node scripts/check-syntax.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:radar": "node radar/scraper/tests/test_front.mjs",
    "test:radar:scraper": "python radar/scraper/tests/test_scraper.py",
    "test:planning": "node planning/frontend/tests/test_month_nav.mjs",
    "test:data": "node --test scripts/test-data-quality.mjs"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2",
    "better-sqlite3": "^9.4.3",
    "node-cron": "^3.0.3",
    "handlebars": "^4.7.8",
    "puppeteer-core": "^22.15.0",
    "@sparticuz/chromium": "^127.0.0"
  },
  "devDependencies": {
    "jsdom": "^24.1.0"
  }
}
