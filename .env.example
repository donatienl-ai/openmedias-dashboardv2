# ==========================================
#  OPENMEDIAS DASHBOARD - VARIABLES D'ENV
# ==========================================
# Copie ce fichier en ".env" et remplis les valeurs.
# NE JAMAIS commiter le fichier .env sur Git !

# --- Mot de passe d'accès au dashboard ---
DASHBOARD_PASSWORD=change-moi

# --- Port (Render le définit automatiquement, laisse vide en prod) ---
PORT=3001

# ==========================================
#  AIRCALL
# ==========================================
# Récupérer dans Aircall > Settings > Integrations > API Keys
# Auth = Basic (API ID : API Token)
AIRCALL_API_ID=ton_api_id
AIRCALL_API_TOKEN=ton_api_token

# ==========================================
#  CALENDLY
# ==========================================
# Personal Access Token (celui que tu utilises déjà dans Make)
# Calendly > Integrations > API & Webhooks > Personal Access Tokens
CALENDLY_TOKEN=ton_personal_access_token
# URI de ton organisation (déjà connu)
CALENDLY_ORG_URI=https://api.calendly.com/organizations/CBCBRNXZXMQEI3KG

# ==========================================
#  SALESFORCE (Client Credentials Flow)
# ==========================================
# Flow serveur-à-serveur : juste Client ID + Secret, PAS de username/password/token.
# Depuis ta Connected App Salesforce (Enable Client Credentials Flow + Run As user) :
SALESFORCE_CLIENT_ID=ton_consumer_key
SALESFORCE_CLIENT_SECRET=ton_consumer_secret
# IMPORTANT : ton My Domain (PAS login.salesforce.com pour ce flow)
SALESFORCE_DOMAIN_URL=https://openmedias.my.salesforce.com


# ==========================================
#  DOCUSIGN (JWT Grant) — BDC envoyés/signés
# ==========================================
# App DocuSign : Settings > Integrations > Apps and Keys
DOCUSIGN_INTEGRATION_KEY=ton_integration_key
# "API Username" (GUID) de l'utilisateur impersonné (toi)
DOCUSIGN_USER_ID=ton_user_id_guid
# "API Account ID" (GUID) — optionnel si un seul compte
DOCUSIGN_ACCOUNT_ID=ton_account_id_guid
# Clé PRIVÉE RSA de l'app (multi-lignes, coller telle quelle)
DOCUSIGN_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# prod = account.docusign.com (défaut) / demo = account-d.docusign.com
DOCUSIGN_OAUTH_HOST=account.docusign.com

# ==========================================
#  REPORTING EMAIL (remplace Make)
# ==========================================
# Clés API Mailjet : Account Settings > REST API > API Key Management
MAILJET_API_KEY=ta_cle_api_mailjet
MAILJET_SECRET_KEY=ta_cle_secrete_mailjet
# Expéditeur (doit être une adresse/domaine VALIDÉ dans Mailjet)
REPORT_FROM_EMAIL=donatien.l@openmedias.fr
REPORT_FROM_NAME=OpenMedias Reporting
# Destinataires (séparés par des virgules)
REPORT_TO=donatien.l@openmedias.fr
# Clé secrète de déclenchement (invente une chaîne longue et aléatoire)
REPORT_KEY=une_cle_secrete_longue_et_aleatoire

# Envoi automatique interne (réglable aussi via la console admin Ctrl+Shift+A)
REPORT_AUTO=false
REPORT_TIME=08:00
# Jours: 0=dim, 1=lun ... 6=sam
REPORT_DAYS=1,2,3,4,5
REPORT_PRESET=today

# ==========================================
#  OPENPLANNING + OPENBDC (fusionnés sous /planning)
# ==========================================
# PIN d'accès édito (planning) — 4 chiffres
PIN_EDIT=5678
PIN_COM=1977
# PIN personnels (accès édito identique en tout point)
PIN_EVA=2602
PIN_FLAVIE=0702
PIN_CLEVEL=1973
# Destinataires des notifs "à programmer" du lundi 14h
EMAIL_EVA=
EMAIL_FLAVIE=
EMAIL_CLEVEL=
# Seul destinataire de l'alerte "BDC en attente" (par défaut : toi)
EMAIL_ADMIN=donatien.l@openmedias.fr
# Secret partagé avec le webhook Salesforce du planning (chaîne aléatoire)
SF_WEBHOOK_SECRET=change-moi-aussi
# Chemin de la base SQLite du planning — DOIT pointer vers le disque persistant
# Render (voir render.yaml : disk monté sur /var/data). En local, laisse vide
# (utilise planning/backend/planning.db par défaut).
DB_PATH=/var/data/planning.db
